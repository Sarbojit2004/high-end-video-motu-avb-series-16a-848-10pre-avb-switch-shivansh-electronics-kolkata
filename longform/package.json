{
  "name": "motu-avb-ecosystem-longform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOTU AVB Series Ecosystem (16A / 848 / 10pre / AVB Switch) \u2014 898s light-background landscape long-form video (Remotion). Shivansh Electronics, Authorized Distributor of MOTU (Mark of the Unicorn, USA) Interfaces for East and North East India.",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "bundle": "remotion bundle",
    "make-assets": "node scripts/copy-assets.mjs",
    "make-sfx": "node scripts/make-sfx.mjs",
    "setup": "npm run make-assets && npm run make-sfx",
    "guard": "node scripts/guard.mjs",
    "coverage": "node scripts/coverage.mjs",
    "branding": "node scripts/branding.mjs",
    "qa": "node scripts/qa-stills.mjs",
    "verify": "npm run typecheck && npm run guard && npm run coverage && npm run branding",
    "render": "remotion render LongForm out/motu-avb-ecosystem-longform.mp4 --concurrency=3",
    "render:chunks": "node scripts/render-chunks.mjs",
    "render:thumb": "remotion still Thumbnail out/thumbnail-motu-avb-ecosystem-longform.png",
    "render:music": "remotion render MusicBedOnly out/motu-avb-longform-music-bed.wav",
    "render:sfx": "remotion render SfxTimelineOnly out/motu-avb-longform-transition-sfx-timeline.wav",
    "render:audio": "npm run render:music && npm run render:sfx",
    "make-zip": "node scripts/make-zip.mjs",
    "join": "node scripts/join-parts.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.497",
    "@remotion/cli": "4.0.497",
    "@remotion/media-utils": "4.0.497",
    "@remotion/renderer": "4.0.497",
    "@remotion/shapes": "4.0.497",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.497"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3",
    "typescript": "5.6.3"
  }
}