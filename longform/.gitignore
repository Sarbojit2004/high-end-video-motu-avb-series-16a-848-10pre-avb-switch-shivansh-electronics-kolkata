node_modules/
.cache/
.zipstage/
out/qa/
out/test/
out/chunks/

# public/ is generated by `npm run setup` from the repository's own source
# assets — see README. Not tracked.
public/

# GitHub hard-rejects files over 100 MB and git-lfs is unavailable in this
# environment, so the following are produced locally and delivered directly:
#   out/motu-avb-ecosystem-longform.mp4      (~240 MB master)
#   out/*.wav                                (172 MB each, uncompressed)
# The master is ALSO committed as chapter parts under out/parts/ (each well
# under 100 MB), which `npm run join` recombines with a stream copy into a
# bit-identical master. The two audio deliverables are committed as FLAC, which
# is lossless and decodes to the exact WAVs.
out/*.mp4
out/*.wav
!out/parts/
