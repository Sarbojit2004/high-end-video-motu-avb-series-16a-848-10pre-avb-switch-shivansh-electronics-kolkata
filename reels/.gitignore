public/

# GitHub rejects files over 100 MB and git-lfs is unavailable in this
# environment. A 178 s reel encodes to ~45 MB so the MP4s ARE tracked; only the
# uncompressed WAV pairs are not (each ~34 MB — tracked, they fit — but the
# FLACs are what ship, see README).
out/*.wav
